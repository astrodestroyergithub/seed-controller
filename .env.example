# NeonDB PostgreSQL Connection String
# Add this in Netlify Site Configuration -> Environment Variables -> DATABASE_URL
DATABASE_URL=postgresql://username:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTIONAL: NCBI PubMed E-Utilities API Key
# The app works out-of-the-box WITHOUT any API key (3 requests/sec free public tier).
# If you want higher rate limits (10 requests/sec), generate a free key at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
