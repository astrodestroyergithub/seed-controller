# ============================================================================
# SEEDCONTROLLER SOVEREIGN — NETLIFY ENVIRONMENT VARIABLES (.env.example)
# ============================================================================

# 1. REQUIRED FOR CLOUD POSTGRESQL PERSISTENCE (NeonDB Connection String)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/YOUR_DB_NAME?sslmode=require

# 2. OPTIONAL LIVE CONTENT API KEYS
# Good news: Reddit scraping and Visual Gallery images work 100% KEYLESS out of the box!
# - Visual Gallery uses 4 built-in Keyless/Pre-Authenticated APIs:
#   1) Art Institute of Chicago Open REST API (100% Keyless)
#   2) Wikimedia Commons Live MediaWiki API (100% Keyless)
#   3) Pollinations.ai Live AI Mural Engine (100% Keyless)
#   4) NASA Open API (Pre-filled with official DEMO_KEY; or get an instant key at https://api.nasa.gov)
# - Live Community Scraper uses 3 built-in Keyless APIs:
#   1) Reddit Public JSON (.json)
#   2) PullPush.io Reddit Search API (api.pullpush.io)
#   3) HackerNews Algolia Search API (hn.algolia.com)

NASA_API_KEY=DEMO_KEY
YOUTUBE_API_KEY=
NCBI_API_KEY=

# Legacy Optional Stock-Photo / OAuth Keys (Leave blank if Pexels/Pixabay/Reddit block signup!)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
