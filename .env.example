# ============================================================================
# 1. REQUIRED FOR CLOUD DATABASE SYNC: NeonDB PostgreSQL Connection String
# Add in Netlify Dashboard -> Site configuration -> Environment variables
# ============================================================================
DATABASE_URL=postgresql://username:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# 2. LIVE PUBLIC API KEYS (Optional in Netlify Env Vars OR enter live in UI!)
# All endpoints include automatic zero-key fallbacks so the app never breaks.
# ============================================================================

# YouTube Data API v3 Key (Fetches live Top 50 NNN & Retention videos)
# Get free key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Reddit API OAuth2 Credentials (Scrapes live r/nonutnovember, r/SemenRetention, r/NoFap)
# Create free 'script' or 'web app' at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Pixabay API Key (Fetches dynamic NNN motivation & stoic warrior visual gallery)
# Get free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Pexels API Key (Alternative high-res visual gallery provider)
# Get free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# NIH NCBI PubMed API Key (Raises PubMed rate limit from 3 req/s to 10 req/s)
# Get free key at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
